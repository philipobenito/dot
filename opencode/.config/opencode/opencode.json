{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "rules/common/*.md",
    "rules/go/*.md",
    "rules/javascript/*.md",
    "rules/php/*.md",
    "rules/python/*.md",
    "rules/rust/*.md",
    "rules/typescript/*.md"
  ],
  "permission": {
    "external_directory": {
      "~/.config/opencode/skills/**": "allow",
      "~/.config/opencode/rules/**": "allow"
    }
  }
}
